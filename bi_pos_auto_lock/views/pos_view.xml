<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_interface_section']" position="before">
                    <h2>POS Screen Lock Timer Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-6 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="enable_lock" />
                            </div>
                            <div class="o_setting_right_pane"><label for="enable_lock" /><br /></div>
                        </div>
                        <div class="col-xs-6 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"></div>
                            <div class="o_setting_right_pane">
                                <label for="lock_timer" invisible = "enable_lock == False"/>
                                <field name="lock_timer" invisible = "enable_lock == False" required="enable_lock == True" style="margin-left: 5px;" />
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
