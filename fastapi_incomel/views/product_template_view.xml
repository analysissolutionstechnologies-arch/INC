<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="product_form_view_catfull_product_template">
        <field name="name">product.catfull.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="full_category_path"  invisible="1"/>
                    <field name="x_studio_modelo"  invisible="0"/>
                    <field name="x_studio_marca"  invisible="0"/>
                    
                    

            </xpath>
        </field>
    </record>
</odoo>