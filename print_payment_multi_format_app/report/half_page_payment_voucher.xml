<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="half_page_payment_voucher_template">
	<t t-call="web.html_container">
		<t t-call="web.external_layout">
			<div class="page" style=" min-width:100%"><br/>
				<div style="font-weight: bold;">
<!--					<div style="display: flex; width: 40%; justify-content: space-between; margin-bottom: 20px">
						<div><img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 90px;" alt="Logo"/></div>
						<div>
							<div><span style="font-weight: bold;" t-esc="doc.company_id.name"/></div>
							<div>TEL: <span style="font-weight: bold;" t-esc="doc.company_id.phone"/></div>
							<div>EMAIL: <span style="font-weight: bold;" t-esc="doc.company_id.email"/></div>
						</div> 
					</div> -->
					<div style="margin-bottom: 30px">
						<div style="height: 80px; display: flex; justify-content: center; color: white; background-color: grey; align-items: center"><h4>RECIBO DE CAJA</h4></div>
						<div style="display: flex; justify-content: flex-end"><h5>NO.: <span style="font-weight: bold;" t-esc="doc.descripcion"/></h5></div>
						<div>
							<div>REF. DOCUMENTO: <span style="font-weight: bold;" t-esc="doc.name"/></div>
							<div>FECHA: <span style="font-weight: bold;" t-esc="doc.date"/></div>
							<div>RECIBI DE: <span style="font-weight: bold;" t-esc="doc.partner_id.name"/></div>
							<div>CTA: <span style="font-weight: bold;" t-esc="doc.partner_id.ref"/></div>
							<div>DESCRIPCION: <span style="font-weight: bold;" t-esc="doc.ref"/></div>
							<div>MONTO EN LETRAS: <span style="font-weight: bold;" t-esc="doc.check_amount_in_words"/></div>

						</div>
					</div>
					<table class="table table-bordered" style="width: 100%;">
						<thead >
							<th>Diario</th>
							<th>NO. BOLETA</th>
							<th>CTA. BANCARIA</th>
							<th>MONTO</th>
						</thead>
						<tbody>
							<td><span style="font-weight: bold;" t-esc="doc.journal_id.name"/></td>
							<td> <span style="font-weight: bold;" t-esc="doc.descripcion"/></td>
							<td> <span style="font-weight: bold;" t-esc="doc.journal_id.name"/></td>
							<td> <span style="font-weight: bold;" t-esc="doc.amount"/></td>
						</tbody>
					</table>
					<div style="font-weight: bold; margin-top: 20px">DOCUMENTOS APLICADOS:</div><br/>
					<table class="table table-bordered" style="width: 100%;">
						<thead >
								<th>TIPO</th>
								<th>FECHA</th>
								<th>NUMERO</th>
								<th>TOTAL</th>
								<th>APLICADO</th>
								<th>SALDO</th>
						</thead>
						<tbody>
							<t t-foreach="doc.reconciled_invoice_ids" t-as="invoice" t-if="invoice">
								<tr>
									<td><span style="font-weight: bold;" t-esc="invoice.journal_id.name"/></td>
									<td><span style="font-weight: bold;" t-esc="invoice.invoice_date"/></td>
									<td><span style="font-weight: bold;" t-esc="invoice.fel_numero_autorizacion"/></td>
									<td><span style="font-weight: bold;" t-esc="invoice.amount_total_signed"/></td>
									<td><span style="font-weight: bold;" t-esc="doc.amount"/></td>
									<td><span style="font-weight: bold;" t-esc="invoice.amount_residual_signed"/></td>
								</tr>
							</t>
							<!-- <t t-if="doc.reconciled_invoice_ids">
								<tr>
									<td><span style="font-weight: bold;" t-esc="doc.reconciled_invoice_ids[0].journal_id.name"/></td>
									<td><span style="font-weight: bold;" t-esc="doc.reconciled_invoice_ids[0].invoice_date"/></td>
									<td><span style="font-weight: bold;" t-esc="doc.reconciled_invoice_ids[0].fel_numero_autorizacion"/></td>
									<td><span style="font-weight: bold;" t-esc="doc.reconciled_invoice_ids[0].amount_total_signed"/></td>
									<td><span style="font-weight: bold;" t-esc="doc.amount"/></td>
									<td><span style="font-weight: bold;" t-esc="doc.reconciled_invoice_ids[0].amount_residual_signed"/></td>
								</tr>
							</t> -->
						</tbody>
					</table>

					<div style="display: flex; justify-content: space-around; margin-top: 90px">
						<div style="display: flex; justify-content: center; width: 30%; padding-top: 10px; border-top: solid 1px black">FIRMA</div><br/>
						<div style="display: flex; justify-content: center; width: 30%; padding-top: 10px; border-top: solid 1px black">SELLO</div><br/>
						<div style="width: 30%; display: flex; flex-direction: column; align-items: center">
							<div>USUARIO: <span style="font-weight: bold;" t-esc="doc.user_id.name"/></div>
							<t t-set="current_date" t-value="datetime.date.today().strftime('%d/%m/%Y')"/>
							<div t-esc="current_date"/>
						</div>
					</div>
				</div>
			</div>
		</t>
	</t>
	</template>

	<template id="half_page_payment_report">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="doc">
				<t t-call="print_payment_multi_format_app.half_page_payment_voucher_template"/>
			</t>
		</t>
	</template>

	<record id="half_page_payment_report_paperformat" model="report.paperformat">
		<field name="name">Half Page Payment Voucher</field>
		<field name="default" eval="True" />
		<field name="format">A4</field>
		<field name="page_height">0</field>
		<field name="page_width">0</field>
		<field name="margin_top">50</field>
		<field name="margin_bottom">20</field>
		<field name="margin_left">10</field>
		<field name="margin_right">10</field>
		<field name="header_line" eval="False" />
		<field name="orientation">Landscape</field>
		<field name="header_spacing">50</field>
		<field name="dpi">80</field>
	</record>

    <record id="half_page_payment_report_action" model="ir.actions.report">
        <field name="name">Half Page Payment Voucher</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">print_payment_multi_format_app.half_page_payment_report</field>
        <field name="report_file">print_payment_multi_format_app.half_page_payment_report</field>
        <field name="paperformat_id" ref="half_page_payment_report_paperformat"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>

</odoo>