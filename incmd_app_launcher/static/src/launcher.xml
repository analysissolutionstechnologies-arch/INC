<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="incmd_app_launcher.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="replace">
            <button t-if="!incmdLauncher.open" t-ref="incmdToggle" type="button" class="incmd_home_button" title="Volver a aplicaciones" aria-label="Volver a aplicaciones" t-att-aria-expanded="incmdLauncher.open ? 'true' : 'false'" aria-controls="incmd_application_home" t-on-click="incmdToggleLauncher">
                <t t-if="currentApp">
                    <img t-if="currentApp.webIconData" class="incmd_current_app_icon" t-att-src="currentApp.webIconData" alt=""/>
                    <span t-else="" class="incmd_current_app_initial" t-esc="currentApp.name.substring(0, 1)"/>
                    <span class="incmd_current_app_name" t-esc="currentApp.name"/>
                </t>
                <i t-else="" class="oi oi-apps" aria-hidden="true"/>
            </button>
            <t t-if="ui.isSmall and !incmdLauncher.open" t-call="web.NavBar.AppsMenu">
                <t t-set="apps" t-value="menuService.getApps()"/>
            </t>
        </xpath>
        <xpath expr="//DropdownItem[contains(@class, 'o_menu_brand')]" position="replace"/>
        <xpath expr="//nav[contains(@class, 'o_main_navbar')]" position="attributes">
            <attribute name="t-att-class">{'incmd_launcher_active': incmdLauncher.open}</attribute>
        </xpath>
        <xpath expr="//header" position="inside">
            <section t-if="incmdLauncher.open" id="incmd_application_home" class="incmd_launcher" aria-label="Aplicaciones">
                <div class="incmd_launcher_content">
                    <div class="incmd_launcher_toolbar">
                        <button type="button" class="incmd_close" title="Cerrar" aria-label="Cerrar aplicaciones" t-on-click="incmdCloseLauncher"><i class="fa fa-times" aria-hidden="true"/></button>
                    </div>
                    <div class="incmd_apps_grid">
                        <button t-foreach="incmdApps" t-as="app" t-key="app.id" type="button" class="incmd_app_tile" t-att-disabled="incmdLauncher.busy" t-att-data-menu-xmlid="app.xmlid" t-on-click="() => this.incmdOpenApp(app)">
                            <span class="incmd_app_icon">
                                <img t-if="app.webIconData" t-att-src="app.webIconData" alt=""/>
                                <span t-else="" class="incmd_app_fallback" t-esc="app.name.substring(0, 1)"/>
                            </span>
                            <span class="incmd_app_name" t-esc="app.name"/>
                        </button>
                    </div>
                    <p t-if="!incmdApps.length" class="incmd_empty">No hay aplicaciones disponibles.</p>
                </div>
            </section>
        </xpath>
    </t>
</templates>
