<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sale_ticket_validation" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_cancel']" position="after">
                <button name="action_validate_ticket_attachment" 
                        string="Crear Ticket" 
                        type="object" 
                        class="btn-primary"
                        invisible="state in ['draft', 'sent'] and not pricelist_id and validar_autorizaion != True"/>
            </xpath>
        </field>
    </record>
</odoo>