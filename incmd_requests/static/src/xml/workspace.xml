<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="incmd_requests.Workspace">
 <div class="incmd_workspace" t-att-class="{'ir_is_busy':state.busy}" t-att-aria-busy="state.busy ? 'true' : 'false'">
  <div t-if="!state.boot" class="ir_loading"><i class="fa fa-circle-o-notch fa-spin"/> Cargando Solicitudes…</div>
  <t t-else="">
   <aside t-if="state.page === 'config' and state.boot.admin" class="ir_sidebar">
    <div class="ir_sidebar_caption">ADMINISTRACIÓN</div>
    <button t-foreach="configSections" t-as="item" t-key="item.key" t-att-class="{'active':state.section === item.key}" t-on-click="() => this.switchSection(item.key)" t-att-disabled="state.busy"><i t-att-class="'fa fa-' + item.icon"/><span t-esc="item.name"/></button>
    <div class="ir_sidebar_note"><i class="fa fa-shield"/> Solo administradores<br/><span>Configuración y permisos</span></div>
   </aside>
   <main class="ir_main">
    <div class="ir_breadcrumb"><a t-on-click="showList">Solicitudes</a><span>›</span><span t-esc="state.page === 'config' ? 'Configuración' : title"/><t t-if="state.page === 'config'"><span>›</span><span t-esc="sectionTitle"/></t><div class="ir_identity"><i class="fa fa-building-o"/><span t-esc="label(state.boot.origin)"/></div></div>
    <div t-if="state.error" class="ir_notice ir_notice_error" role="alert"><i class="fa fa-exclamation-circle"/><span t-esc="state.error"/><button class="ir_icon_btn" t-on-click="() => state.error = ''" aria-label="Cerrar error">×</button></div>
    <t t-if="state.page === 'list'" t-call="incmd_requests.List"/>
    <t t-elif="state.page === 'new'" t-call="incmd_requests.New"/>
    <t t-elif="state.page === 'detail' and state.detail" t-call="incmd_requests.Detail"/>
    <t t-elif="state.page === 'board'" t-call="incmd_requests.Board"/>
    <t t-elif="state.page === 'config' and state.config and state.boot.admin" t-call="incmd_requests.Configuration"/>
   </main>
   <div t-if="state.busy" class="ir_progress_line"/>
  </t>
 </div>
</t>

<t t-name="incmd_requests.List">
 <div class="ir_heading"><div><h1 t-esc="title"/><p>Consulta y da seguimiento a tus requerimientos.</p></div><div class="ir_search"><i class="fa fa-search"/><input aria-label="Buscar solicitudes" placeholder="Buscar por solicitud o asunto…" t-model="state.query" t-on-keydown="searchKey"/><button t-on-click="filter" t-att-disabled="state.busy">Buscar</button></div></div>
 <div class="ir_toolbar"><button class="ir_btn ir_primary" t-on-click="newRequest" t-att-disabled="state.busy"><i class="fa fa-plus"/> Nueva solicitud</button><div class="ir_filterbar">
  <select aria-label="Vista de solicitudes" t-att-value="state.mode" t-on-change="ev => this.changeMode(ev.target.value)" t-att-disabled="state.busy"><option value="mine">Mis solicitudes</option><option value="inbox">Por atender</option><option t-if="state.boot.supervisor" value="supervision">Mis áreas y tiendas</option></select>
  <select aria-label="Filtrar origen" t-model="state.origin" t-on-change="filter" t-att-disabled="state.busy"><option value="">Todas las áreas / tiendas de origen</option><option t-foreach="state.boot.units" t-as="unit" t-key="unit.id" t-att-value="unit.id" t-esc="unit.name"/></select>
  <select aria-label="Filtrar estado" t-model="state.status" t-on-change="filter" t-att-disabled="state.busy"><option value="">Todos los estados</option><option value="draft">Borradores</option><option value="open">En atención</option><option value="done">Finalizadas</option><option value="rejected">Rechazadas</option></select>
  <button class="ir_btn ir_secondary" t-on-click="showBoard" t-att-disabled="state.busy"><i class="fa fa-columns"/> Tablero</button>
 </div></div>
 <section class="ir_panel ir_table_panel"><div class="ir_table_scroll"><table class="ir_table"><thead><tr><th>Solicitud</th><th>Asunto</th><th>Origen</th><th>Área destino</th><th>Motivo</th><th>Etapa</th><th>Responsable</th><th>Creada</th></tr></thead><tbody>
  <tr t-foreach="state.records" t-as="r" t-key="r.id" t-on-click="() => this.openRecord(r.id)" tabindex="0" t-on-keydown="ev => this.rowKey(ev,r.id)"><td><button class="ir_link" t-esc="r.number"/></td><td class="ir_subject" t-esc="r.name"/><td t-esc="label(r.origin_id)"/><td t-esc="label(r.unit_id)"/><td t-esc="label(r.reason_id)"/><td><span t-att-class="'ir_badge ir_state_' + r.state" t-esc="r.stage_id ? r.stage_id[1] : statusName(r.state)"/></td><td t-esc="label(r.responsible_id)"/><td t-esc="date(r.create_date)"/></tr>
  <tr t-if="!state.records.length"><td colspan="8"><div class="ir_empty"><i class="fa fa-inbox"/><h3>No hay solicitudes en esta vista</h3><p>Crea una solicitud o ajusta los filtros de búsqueda.</p></div></td></tr>
 </tbody></table></div><div class="ir_pagination"><span><t t-esc="state.total"/> solicitudes</span><div><button class="ir_icon_btn" aria-label="Página anterior" t-att-disabled="state.offset === 0 or state.busy" t-on-click="() => this.pageBy(-1)"><i class="fa fa-chevron-left"/></button><span><t t-esc="state.total ? state.offset + 1 : 0"/>–<t t-esc="Math.min(state.offset + 40, state.total)"/> de <t t-esc="state.total"/></span><button class="ir_icon_btn" aria-label="Página siguiente" t-att-disabled="state.offset + 40 >= state.total or state.busy" t-on-click="() => this.pageBy(1)"><i class="fa fa-chevron-right"/></button></div></div></section>
</t>

<t t-name="incmd_requests.New">
 <div class="ir_heading"><div><h1 t-esc="title"/><p>Selecciona el área y el motivo de tu requerimiento.</p></div><div class="ir_actions"><span class="ir_badge ir_state_draft">Borrador</span><button class="ir_btn ir_secondary" t-on-click="() => this.saveDraft(false)" t-att-disabled="state.busy"><i class="fa fa-save"/> Guardar borrador</button><button class="ir_btn ir_primary" t-on-click="() => this.saveDraft(true)" t-att-disabled="state.busy"><i class="fa fa-paper-plane"/> Enviar solicitud</button></div></div>
 <section class="ir_panel ir_new_panel">
  <div t-if="!state.boot.origin" class="ir_notice ir_notice_warning"><i class="fa fa-exclamation-triangle"/> Falta asignar tu área o tienda. Solicita al administrador que revise tu ficha de Empleados o la asignación de usuario.</div>
  <div class="ir_form_grid"><label class="ir_field"><span>Solicitante</span><div class="ir_readonly"><i class="fa fa-user"/><span t-esc="state.boot.user_name"/></div></label><label class="ir_field"><span>Origen</span><div class="ir_readonly"><i class="fa fa-building"/><span t-esc="label(state.boot.origin)"/><i class="fa fa-lock ir_push"/></div><small>Se completa automáticamente con tu área o tienda.</small></label>
   <label class="ir_field"><span>Área destinataria <b>*</b></span><select t-att-value="state.form.unit_id" t-on-change="changeFormUnit" t-att-disabled="state.busy"><option value="">Seleccionar área…</option><option t-foreach="receivingUnits" t-as="unit" t-key="unit.id" t-att-value="unit.id" t-esc="unit.name"/></select></label>
   <label class="ir_field"><span>Motivo <b>*</b></span><select t-model="state.form.reason_id" t-att-disabled="!state.form.unit_id or state.busy"><option value="">Seleccionar motivo…</option><option t-foreach="formReasons" t-as="reason" t-key="reason.id" t-att-value="reason.id" t-esc="reason.name"/></select><small t-if="formReason and formReason.description" t-esc="formReason.description"/></label>
  </div>
  <div class="ir_new_body"><div><label class="ir_field"><span>Asunto <b>*</b></span><input placeholder="Escribe el asunto de tu solicitud" maxlength="250" t-model="state.form.name" t-att-disabled="state.busy"/></label><label class="ir_field"><span>Descripción <b>*</b></span><textarea rows="8" placeholder="Describe lo que necesitas y agrega los detalles para atenderlo…" t-model="state.form.description" t-att-disabled="state.busy"/></label></div>
   <aside class="ir_upload_box"><h3>Adjuntos</h3><label class="ir_upload_target"><i class="fa fa-cloud-upload"/><span class="ir_btn ir_secondary"><i class="fa fa-paperclip"/> Seleccionar archivos</span><small>Documentos, imágenes y evidencia<br/>Hasta 25 MB por archivo</small><input type="file" multiple="multiple" t-on-change="readFiles" t-att-disabled="state.busy"/></label><t t-foreach="state.form.original_attachment_ids" t-as="id" t-key="id"><a class="ir_attachment" t-att-href="download(id)" target="_blank" rel="noopener"><i class="fa fa-paperclip"/><span t-esc="attachment(id).name"/></a></t><t t-call="incmd_requests.PendingFiles"/></aside>
  </div>
  <div class="ir_notice"><i class="fa fa-info-circle"/> Al enviar, los datos y documentos originales quedan bloqueados y la solicitud pasará al área correspondiente.</div>
 </section><button class="ir_back" t-on-click="back" t-att-disabled="state.busy"><i class="fa fa-arrow-left"/> Volver a solicitudes</button>
</t>

<t t-name="incmd_requests.PendingFiles"><div t-if="state.files.length" class="ir_pending_files"><div t-foreach="state.files" t-as="file" t-key="file.key" class="ir_pending_file"><i class="fa fa-paperclip"/><span t-esc="file.name"/><small t-esc="bytes(file.size)"/><button class="ir_icon_btn" aria-label="Quitar adjunto pendiente" t-on-click="() => this.removeFile(file.key)" t-att-disabled="state.busy">×</button></div></div></t>

<t t-name="incmd_requests.Detail">
 <div class="ir_heading ir_detail_heading"><div><h1><span t-esc="state.detail.number"/> · <span t-esc="state.detail.name"/></h1><div class="ir_muted">Creada el <t t-esc="date(state.detail.create_date)"/> · <t t-esc="label(state.detail.process_id)"/></div></div><button class="ir_btn ir_secondary" t-on-click="showBoard" t-att-disabled="state.busy"><i class="fa fa-columns"/> Ver proceso</button></div>
 <div class="ir_steps" aria-label="Etapas del proceso"><div t-foreach="stages" t-as="stage" t-key="stage.id" class="ir_step" t-att-class="{'current':state.detail.stage_id and stage.id === state.detail.stage_id[0],'closed':stage.is_closed}"><i t-if="stage.is_closed" class="fa fa-check"/><span t-esc="stage.name"/></div></div>
 <div class="ir_detail_grid">
  <section class="ir_panel ir_original"><header class="ir_panel_header ir_locked"><i class="fa fa-lock"/> Solicitud original · Solo lectura</header><div class="ir_panel_body"><dl class="ir_definition"><dt>Solicitante</dt><dd t-esc="label(state.detail.requester_id)"/><dt>Origen</dt><dd t-esc="label(state.detail.origin_id)"/><dt>Área destinataria</dt><dd t-esc="label(state.detail.original_unit_id || state.detail.unit_id)"/><dt>Motivo</dt><dd t-esc="label(state.detail.original_reason_id || state.detail.reason_id)"/><dt>Asunto</dt><dd t-esc="state.detail.name"/></dl><h4>Descripción</h4><div class="ir_description" t-esc="state.detail.description"/><h4>Adjuntos originales</h4><div t-if="!state.detail.original_attachment_ids.length" class="ir_muted">Sin documentos originales.</div><a t-foreach="state.detail.original_attachment_ids" t-as="id" t-key="id" class="ir_attachment" t-att-href="download(id)" target="_blank" rel="noopener"><i class="fa fa-paperclip"/><span t-esc="attachment(id).name"/><small t-esc="bytes(attachment(id).file_size)"/></a></div></section>
  <section class="ir_panel ir_attention"><header class="ir_panel_header"><i class="fa fa-tasks"/> <t t-esc="state.detail.approval ? 'Autorización de la solicitud' : 'Atención de la solicitud'"/></header><div class="ir_panel_body">
   <dl class="ir_definition"><dt>Área actual</dt><dd t-esc="label(state.detail.unit_id)"/><dt>Motivo actual</dt><dd t-esc="label(state.detail.reason_id)"/></dl><button t-if="state.detail.can_handle" class="ir_btn ir_secondary ir_full" t-on-click="redirectRequest" t-att-disabled="state.busy"><i class="fa fa-exchange"/> Redirigir a otra área</button><div class="ir_status_line"><span t-att-class="'ir_badge ir_state_' + state.detail.state" t-esc="statusName(state.detail.state)"/></div>
   <t t-if="state.detail.state === 'open' and (state.detail.can_handle or state.detail.is_owner)">
    <label t-if="state.detail.can_handle" class="ir_field"><span>Responsable</span><select t-model="state.responsible" t-att-disabled="state.busy"><option value="" t-esc="state.detail.responsible_id ? 'Conservar: ' + label(state.detail.responsible_id) : 'Sin asignar'"/><option t-foreach="state.detail.team" t-as="member" t-key="member.id" t-att-value="member.id" t-esc="member.name"/></select></label>
    <label class="ir_field"><span>Comentario de avance <b>*</b></span><textarea class="ir_followup_text" rows="6" placeholder="Describe la gestión o responde la aclaración…" t-model="state.comment" t-att-disabled="state.busy"/></label>
    <label class="ir_file_button ir_btn ir_secondary"><i class="fa fa-paperclip"/> Adjuntar seguimiento<input type="file" multiple="multiple" t-on-change="readFiles" t-att-disabled="state.busy"/></label><t t-call="incmd_requests.PendingFiles"/>
    <small t-if="state.detail.attachment_required and state.detail.can_handle" class="ir_evidence_note"><i class="fa fa-info-circle"/> Esta etapa exige una nueva evidencia al ejecutar una acción.</small>
    <button class="ir_btn ir_primary ir_full" t-on-click="() => this.followup(false)" t-att-disabled="state.busy"><i class="fa fa-comment"/> Registrar avance</button>
    <div t-if="state.detail.can_handle" class="ir_transition_actions"><button class="ir_btn ir_secondary" t-on-click="requestClarification" t-att-disabled="state.busy"><i class="fa fa-question-circle"/> Solicitar aclaración</button><button t-foreach="state.detail.transitions" t-as="transition" t-key="transition.id" t-att-class="'ir_btn ' + (transition.kind === 'reject' ? 'ir_danger' : transition.kind === 'return' ? 'ir_secondary' : 'ir_primary')" t-on-click="() => this.followup(transition)" t-att-disabled="state.busy"><i t-att-class="'fa fa-' + (transition.kind === 'reject' ? 'times' : transition.kind === 'approve' ? 'check' : transition.kind === 'return' ? 'undo' : 'arrow-right')"/><span t-esc="transition.name"/></button></div>
   </t>
   <t t-else=""><div class="ir_closed_note"><i t-att-class="'fa fa-' + (state.detail.state === 'open' ? 'eye' : 'check-circle')"/><h3 t-esc="state.detail.state === 'open' ? 'Consulta de seguimiento' : 'Solicitud cerrada'"/><p t-esc="state.detail.state === 'open' ? 'Puedes consultar el historial. La etapa la atienden sus responsables autorizados.' : 'El historial y la evidencia se conservan para consulta.'"/><span t-if="state.detail.closed_at" t-esc="date(state.detail.closed_at, true)"/></div><dl class="ir_definition"><dt>Responsable</dt><dd t-esc="label(state.detail.responsible_id)"/></dl></t>
  </div></section>
  <section class="ir_panel ir_timeline_panel"><header class="ir_panel_header"><i class="fa fa-comments"/> Conversación, actividades y bitácora</header><Chatter t-key="state.detail.id + ':' + state.detail.history.length" threadModel="'incmd.request'" threadId="state.detail.id"/></section>
 </div><div class="ir_notice"><i class="fa fa-info-circle"/> Los datos originales permanecen bloqueados. Cada motivo utiliza sus propias etapas.</div><button class="ir_back" t-on-click="back" t-att-disabled="state.busy"><i class="fa fa-arrow-left"/> Volver a la bandeja</button>
</t>

<t t-name="incmd_requests.Board">
 <div class="ir_heading"><div><h1>Bandeja del área</h1><p t-esc="currentProcess ? label(currentProcess.unit_id) + ' · ' + currentProcess.display_title : 'Selecciona un proceso para mostrar sus etapas.'"/></div><div class="ir_actions"><button class="ir_btn ir_secondary" t-on-click="showList" t-att-disabled="state.busy"><i class="fa fa-list"/> Lista</button><button class="ir_btn ir_primary" t-on-click="newRequest" t-att-disabled="state.busy"><i class="fa fa-plus"/> Nueva solicitud</button></div></div>
 <div class="ir_toolbar"><div class="ir_filterbar"><select aria-label="Área del tablero" t-model="state.unit" t-on-change="changeBoardUnit" t-att-disabled="state.busy"><option value="">Todas las áreas</option><option t-foreach="receivingUnits" t-as="unit" t-key="unit.id" t-att-value="unit.id" t-esc="unit.name"/></select><select aria-label="Proceso del tablero" t-model="state.process" t-on-change="filter" t-att-disabled="state.busy"><option value="">Seleccionar proceso…</option><option t-foreach="boardProcesses" t-as="process" t-key="process.id" t-att-value="process.id" t-esc="process.display_title"/></select><select aria-label="Ámbito del tablero" t-model="state.mode" t-on-change="filter" t-att-disabled="state.busy"><option value="mine">Mis solicitudes</option><option value="inbox">Por atender</option><option t-if="state.boot.supervisor" value="supervision">Mis áreas y tiendas</option></select></div><div class="ir_notice ir_compact"><i class="fa fa-info-circle"/> Cada proceso muestra sus propias etapas.</div></div>
 <div class="ir_board"><section t-foreach="state.columns" t-as="column" t-key="column.id" class="ir_board_column" t-att-style="'--stage-color:' + (column.closed ? '#dcf7e5' : ['#e9edf3','#d9efff','#fff1c3','#eee4ff'][column_index % 4])"><header><h3 t-esc="column.name"/><span t-esc="column.total"/></header><div class="ir_column_cards"><button t-foreach="column.cards" t-as="card" t-key="card.id" class="ir_request_card" t-on-click="() => this.openRecord(card.id)" t-att-disabled="state.busy"><div class="ir_card_meta"><strong t-esc="card.number"/><time t-esc="age(card.submitted_at)"/></div><h4 t-esc="card.name"/><div class="ir_card_origin"><i class="fa fa-building"/><span t-esc="label(card.origin_id)"/></div><div class="ir_card_user"><span class="ir_avatar ir_avatar_small" t-esc="initials(card.responsible_id ? card.responsible_id[1] : card.requester_id[1])"/><span t-esc="card.responsible_id ? card.responsible_id[1] : 'Sin asignar'"/></div></button><div t-if="!column.cards.length" class="ir_column_empty">Sin solicitudes</div><small t-if="column.total > column.cards.length" class="ir_board_limit">Se muestran <t t-esc="column.cards.length"/> de <t t-esc="column.total"/>. Usa la vista Lista para consultar todas.</small></div></section><div t-if="!state.columns.length" class="ir_empty ir_panel"><i class="fa fa-columns"/><h3>Sin proceso seleccionado</h3><p>Elige un proceso publicado para ver su bandeja.</p></div></div>
</t>

<t t-name="incmd_requests.Configuration">
 <div class="ir_heading"><div><h1 t-esc="state.editor ? (state.editor.id ? 'Configurar ' : 'Crear ') + ({units:'área o tienda',assignments:'asignación de usuario',reasons:'motivo',processes:'proceso'}[state.section]) : sectionTitle"/><p t-esc="state.section === 'processes' ? 'Define las etapas, responsables y acciones de cada proceso.' : 'Administra la configuración de solicitudes de tu compañía.'"/></div><div class="ir_actions"><t t-if="state.editor"><button class="ir_btn ir_secondary" t-on-click="closeConfig" t-att-disabled="state.busy">Volver</button><button t-if="!state.editor.published" class="ir_btn ir_primary" t-on-click="() => this.saveConfig(false)" t-att-disabled="state.busy"><i class="fa fa-save"/> Guardar</button><button t-if="state.editor.kind === 'processes' and state.editor.published" class="ir_btn ir_secondary" t-on-click="newVersion" t-att-disabled="state.busy"><i class="fa fa-copy"/> Nueva versión</button></t><button t-else="" class="ir_btn ir_primary" t-on-click="() => this.editConfig()" t-att-disabled="state.busy"><i class="fa fa-plus"/> Nuevo</button></div></div>
 <section t-if="!state.editor" class="ir_panel ir_table_panel"><div class="ir_table_scroll"><table class="ir_table"><thead><tr><th t-esc="state.section === 'assignments' ? 'Usuario' : 'Nombre'"/><t t-if="state.section === 'units'"><th>Tipo</th><th>Recibe solicitudes</th><th>Supervisores</th></t><t t-elif="state.section === 'assignments'"><th>Área o tienda</th><th>Perfil</th></t><t t-elif="state.section === 'reasons'"><th>Área destinataria</th><th>Proceso asignado</th><th>Activo</th></t><t t-else=""><th>Área</th><th>Versión</th><th>Estado</th></t><th/></tr></thead><tbody>
  <tr t-foreach="configRows" t-as="row" t-key="row.id"><td><button class="ir_link" t-on-click="() => this.editConfig(row)" t-esc="state.section === 'assignments' ? label(row.user_id) : row.name"/></td><t t-if="state.section === 'units'"><td t-esc="row.kind === 'area' ? 'Área' : 'Tienda'"/><td t-esc="row.receives ? 'Sí' : 'No'"/><td><span t-foreach="row.supervisor_ids" t-as="uid" t-key="uid" class="ir_tag" t-esc="state.config.users.find(u => u.id === uid)?.name || 'Usuario'"/></td></t><t t-elif="state.section === 'assignments'"><td t-esc="label(row.unit_id)"/><td><span class="ir_badge ir_state_open" t-esc="{user:'Usuario',supervisor:'Supervisor',admin:'Administrador'}[row.role]"/></td></t><t t-elif="state.section === 'reasons'"><td t-esc="label(row.unit_id)"/><td t-esc="label(row.process_id)"/><td t-esc="row.active ? 'Sí' : 'No'"/></t><t t-else=""><td t-esc="label(row.unit_id)"/><td t-esc="row.version"/><td><span t-att-class="'ir_badge ir_state_' + (row.state === 'published' ? 'done' : 'draft')" t-esc="row.state === 'published' ? 'Publicada' : 'Borrador'"/></td></t><td class="ir_row_actions"><button class="ir_icon_btn" aria-label="Abrir configuración" t-on-click="() => this.editConfig(row)"><i t-att-class="row.state === 'published' ? 'fa fa-eye' : 'fa fa-pencil'"/></button><button t-if="row.state !== 'published'" class="ir_icon_btn" aria-label="Eliminar configuración" t-on-click="() => this.removeConfig(state.section, row.id)" t-att-disabled="state.busy"><i class="fa fa-trash-o"/></button></td></tr>
  <tr t-if="!configRows.length"><td colspan="5"><div class="ir_empty"><i class="fa fa-folder-open-o"/><h3>No hay registros configurados</h3><p>Usa Nuevo para agregar el primero.</p></div></td></tr>
 </tbody></table></div></section>
 <t t-else=""><section class="ir_panel ir_config_form"><t t-set="editor" t-value="state.editor"/><t t-set="fields" t-value="configFields"/><t t-set="nested" t-value="false"/><t t-call="incmd_requests.ConfigFields"/>
  <div t-if="state.editor.kind === 'reasons'" class="ir_notice"><i class="fa fa-info-circle"/> El motivo determina el proceso de atención. Solo se pueden seleccionar versiones publicadas del área.</div>
  <div t-if="state.editor.kind === 'assignments'" class="ir_notice"><i class="fa fa-info-circle"/> El perfil se aplica al usuario en todo el módulo. Las áreas y tiendas a cargo del supervisor se seleccionan en cada unidad.</div>
  <div t-if="state.editor.kind === 'units'" class="ir_notice"><i class="fa fa-info-circle"/> Vincula un departamento de Empleados o asigna esta unidad directamente a los usuarios. Un supervisor puede tener varias unidades a cargo.</div>
 </section>
 <t t-if="state.editor.kind === 'processes'"><section class="ir_panel ir_flow_editor"><header class="ir_panel_header ir_flow_header"><h3>Etapas del proceso</h3><span t-att-class="'ir_badge ir_state_' + (state.editor.published ? 'done' : 'draft')" t-esc="state.editor.published ? 'Publicada' : 'Borrador'"/></header><div class="ir_notice" t-if="state.editor.published"><i class="fa fa-lock"/> Esta versión conserva las solicitudes existentes. Crea una nueva versión para cambiar sus etapas o acciones.</div><div class="ir_notice ir_notice_warning" t-if="!state.editor.id"><i class="fa fa-info-circle"/> Guarda el proceso antes de agregar etapas.</div>
  <div class="ir_tabs"><button t-att-class="{'active':state.flowTab === 'stages'}" t-on-click="() => state.flowTab = 'stages'">1. Etapas y responsables</button><button t-att-class="{'active':state.flowTab === 'transitions'}" t-on-click="() => state.flowTab = 'transitions'">2. Acciones permitidas</button></div>
  <div class="ir_table_scroll"><table t-if="state.flowTab === 'stages'" class="ir_table"><thead><tr><th>Orden</th><th>Etapa</th><th>Responsable</th><th>Aprobación</th><th>Inicial</th><th>Cierre</th><th>Acciones</th></tr></thead><tbody><tr t-foreach="processStages" t-as="stage" t-key="stage.id"><td><span t-esc="stage.sequence"/><span t-if="!state.editor.published" class="ir_reorder"><button class="ir_icon_btn" aria-label="Subir etapa" t-on-click="() => this.moveStage(stage,-1)" t-att-disabled="stage_first or state.busy"><i class="fa fa-angle-up"/></button><button class="ir_icon_btn" aria-label="Bajar etapa" t-on-click="() => this.moveStage(stage,1)" t-att-disabled="stage_last or state.busy"><i class="fa fa-angle-down"/></button></span></td><td t-esc="stage.name"/><td t-esc="actorLabel(stage.actor_type)"/><td t-esc="stage.requires_approval ? 'Sí' : 'No'"/><td t-esc="stage.is_initial ? 'Sí' : 'No'"/><td t-esc="stage.is_closed ? 'Sí' : 'No'"/><td><button class="ir_icon_btn" aria-label="Configurar etapa" t-on-click="() => this.editStage('stages', stage)"><i t-att-class="state.editor.published ? 'fa fa-eye' : 'fa fa-pencil'"/></button><button t-if="!state.editor.published" class="ir_icon_btn" aria-label="Eliminar etapa" t-on-click="() => this.removeConfig('stages', stage.id)" t-att-disabled="state.busy"><i class="fa fa-trash-o"/></button></td></tr></tbody></table>
   <table t-else="" class="ir_table"><thead><tr><th>Acción</th><th>Desde</th><th>Destino</th><th>Tipo</th><th/></tr></thead><tbody><tr t-foreach="processTransitions" t-as="route" t-key="route.id"><td t-esc="route.name"/><td t-esc="label(route.from_stage_id)"/><td t-esc="label(route.to_stage_id)"/><td t-esc="{advance:'Avanzar',approve:'Aprobar',return:'Devolver',reject:'Rechazar'}[route.kind]"/><td><button class="ir_icon_btn" aria-label="Configurar acción" t-on-click="() => this.editStage('transitions', route)"><i t-att-class="state.editor.published ? 'fa fa-eye' : 'fa fa-pencil'"/></button><button t-if="!state.editor.published" class="ir_icon_btn" aria-label="Eliminar acción" t-on-click="() => this.removeConfig('transitions', route.id)" t-att-disabled="state.busy"><i class="fa fa-trash-o"/></button></td></tr></tbody></table></div>
  <footer class="ir_panel_footer"><button t-if="!state.editor.published" class="ir_btn ir_secondary" t-on-click="() => this.editStage(state.flowTab === 'stages' ? 'stages' : 'transitions')" t-att-disabled="!state.editor.id or state.busy"><i class="fa fa-plus"/><t t-esc="state.flowTab === 'stages' ? 'Agregar etapa' : 'Agregar acción'"/></button><span class="ir_push"/><button t-if="state.editor.id and !state.editor.published" class="ir_btn ir_primary" t-on-click="publishProcess" t-att-disabled="state.busy"><i class="fa fa-paper-plane"/> Publicar versión</button></footer>
 </section><section class="ir_notice"><i class="fa fa-info-circle"/> Después de publicar, asigna esta versión a los motivos correspondientes. Las solicitudes enviadas mantienen la versión con la que iniciaron.</section></t></t>
 <div t-if="state.stageEditor" class="ir_dialog_overlay" t-on-click="closeStageOverlay"><section class="ir_dialog" role="dialog" aria-modal="true" t-att-aria-label="state.stageEditor.kind === 'stages' ? 'Configurar etapa' : 'Configurar acción'"><header><div><h2 t-esc="state.stageEditor.kind === 'stages' ? 'Configurar una etapa' : 'Acción permitida'"/><p t-esc="state.editor.values.name"/></div><button class="ir_icon_btn" aria-label="Cerrar diálogo" t-on-click="() => state.stageEditor = null" t-att-disabled="state.busy">×</button></header><div class="ir_dialog_body"><t t-set="editor" t-value="{...state.stageEditor, published:state.editor.published}"/><t t-set="fields" t-value="fieldsFor(state.stageEditor.kind)"/><t t-set="nested" t-value="true"/><t t-call="incmd_requests.ConfigFields"/><div class="ir_notice"><i class="fa fa-info-circle"/><t t-esc="state.stageEditor.kind === 'stages' ? 'Todo avance requiere comentario. Las acciones de aprobación se autorizan según el responsable de la etapa.' : 'La acción se ejecuta con los permisos de la etapa de origen.'"/></div></div><footer><button class="ir_btn ir_secondary" t-on-click="() => state.stageEditor = null" t-att-disabled="state.busy">Cerrar</button><button t-if="!state.editor.published" class="ir_btn ir_primary" t-on-click="() => this.saveConfig(true)" t-att-disabled="state.busy">Guardar</button></footer></section></div>
</t>

<t t-name="incmd_requests.ConfigFields"><div class="ir_config_fields"><label t-foreach="fields" t-as="field" t-key="field.key" class="ir_field" t-att-class="{'ir_field_wide':field.type === 'textarea' or field.type === 'multi','ir_toggle_field':field.type === 'toggle'}"><span t-esc="field.label"/>
 <textarea t-if="field.type === 'textarea'" rows="4" t-att-value="editor.values[field.key] || ''" t-on-input="ev => this.setConfigValue(ev,field,nested)" t-att-disabled="editor.published or state.busy"/>
 <select t-elif="field.type === 'select'" t-att-value="editor.values[field.key] || ''" t-on-change="ev => this.setConfigValue(ev,field,nested)" t-att-disabled="editor.published or state.busy"><option value="">Seleccionar…</option><option t-foreach="field.options" t-as="option" t-key="option.id" t-att-value="option.id" t-att-selected="option.id == editor.values[field.key]" t-esc="option.name"/></select>
 <select t-elif="field.type === 'multi'" multiple="multiple" size="4" t-on-change="ev => this.setConfigValue(ev,field,nested)" t-att-disabled="editor.published or state.busy"><option t-foreach="field.options" t-as="option" t-key="option.id" t-att-value="option.id" t-att-selected="(editor.values[field.key] || []).includes(option.id)" t-esc="option.name"/></select>
 <span t-elif="field.type === 'toggle'" class="ir_switch"><input type="checkbox" t-att-checked="editor.values[field.key]" t-on-change="ev => this.setConfigValue(ev,field,nested)" t-att-disabled="editor.published or state.busy"/><span class="ir_switch_track"/></span>
 <input t-else="" t-att-type="field.type" t-att-value="editor.values[field.key] || ''" t-on-input="ev => this.setConfigValue(ev,field,nested)" t-att-disabled="editor.published or state.busy"/>
 <small t-if="field.type === 'multi'">Selecciona varios con Ctrl (Windows) o Cmd (Mac).</small>
</label></div></t>
</templates>
