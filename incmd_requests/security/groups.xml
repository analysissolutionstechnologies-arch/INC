<odoo>
 <record id="module_category_requests" model="ir.module.category"><field name="name">Gestión de Solicitudes</field><field name="sequence">30</field></record>
 <record id="privilege_requests" model="res.groups.privilege"><field name="name">Gestión de Solicitudes</field><field name="category_id" ref="module_category_requests"/></record>
 <record id="group_user" model="res.groups"><field name="name">Usuario</field><field name="sequence">10</field><field name="privilege_id" ref="privilege_requests"/><field name="implied_ids" eval="[(4,ref('base.group_user'))]"/></record>
 <record id="group_supervisor" model="res.groups"><field name="name">Supervisor</field><field name="sequence">20</field><field name="privilege_id" ref="privilege_requests"/><field name="implied_ids" eval="[(4,ref('group_user'))]"/></record>
 <record id="group_admin" model="res.groups"><field name="name">Administrador</field><field name="sequence">30</field><field name="privilege_id" ref="privilege_requests"/><field name="implied_ids" eval="[(4,ref('group_supervisor'))]"/><field name="user_ids" eval="[(4,ref('base.user_admin'))]"/></record>
</odoo>
