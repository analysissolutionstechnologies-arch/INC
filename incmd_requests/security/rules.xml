<odoo>
<record id="company_unit" model="ir.rule"><field name="name">Compañías: unit</field><field name="model_id" ref="model_incmd_request_unit"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="company_assignment" model="ir.rule"><field name="name">Compañías: assignment</field><field name="model_id" ref="model_incmd_request_assignment"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="company_reason" model="ir.rule"><field name="name">Compañías: reason</field><field name="model_id" ref="model_incmd_request_reason"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="company_process" model="ir.rule"><field name="name">Compañías: process</field><field name="model_id" ref="model_incmd_request_process"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="company_stage" model="ir.rule"><field name="name">Compañías: stage</field><field name="model_id" ref="model_incmd_request_stage"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="company_transition" model="ir.rule"><field name="name">Compañías: transition</field><field name="model_id" ref="model_incmd_request_transition"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="company_request" model="ir.rule"><field name="name">Compañías: request</field><field name="model_id" ref="model_incmd_request"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="company_history" model="ir.rule"><field name="name">Compañías: history</field><field name="model_id" ref="model_incmd_request_history"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_request_user" model="ir.rule"><field name="name">request: user</field><field name="model_id" ref="model_incmd_request"/><field name="groups" eval="[(4,ref('group_user'))]"/><field name="domain_force">['|','&amp;',('state','=','draft'),('requester_id','=',user.id),'&amp;',('state','!=','draft'),'|','|',('requester_id','=',user.id),('unit_id.member_ids','in',[user.id]),('stage_id.actor_ids','in',[user.id])]</field></record>
<record id="rule_request_supervisor" model="ir.rule"><field name="name">request: supervisor</field><field name="model_id" ref="model_incmd_request"/><field name="groups" eval="[(4,ref('group_supervisor'))]"/><field name="domain_force">[('state','!=','draft'),('origin_id.supervisor_ids','in',[user.id])]</field></record>
<record id="rule_request_admin" model="ir.rule"><field name="name">request: admin</field><field name="model_id" ref="model_incmd_request"/><field name="groups" eval="[(4,ref('group_admin'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
<record id="rule_history_user" model="ir.rule"><field name="name">history: user</field><field name="model_id" ref="model_incmd_request_history"/><field name="groups" eval="[(4,ref('group_user'))]"/><field name="domain_force">['|','&amp;',('request_id.state','=','draft'),('request_id.requester_id','=',user.id),'&amp;',('request_id.state','!=','draft'),'|','|',('request_id.requester_id','=',user.id),('request_id.unit_id.member_ids','in',[user.id]),('request_id.stage_id.actor_ids','in',[user.id])]</field></record>
<record id="rule_history_supervisor" model="ir.rule"><field name="name">history: supervisor</field><field name="model_id" ref="model_incmd_request_history"/><field name="groups" eval="[(4,ref('group_supervisor'))]"/><field name="domain_force">[('request_id.state','!=','draft'),('request_id.origin_id.supervisor_ids','in',[user.id])]</field></record>
<record id="rule_history_admin" model="ir.rule"><field name="name">history: admin</field><field name="model_id" ref="model_incmd_request_history"/><field name="groups" eval="[(4,ref('group_admin'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
<record id="assignment_self" model="ir.rule"><field name="name">Asignación propia</field><field name="model_id" ref="model_incmd_request_assignment"/><field name="groups" eval="[(4,ref('group_user'))]"/><field name="domain_force">[('user_id','=',user.id)]</field></record>
<record id="assignment_admin" model="ir.rule"><field name="name">Asignaciones: administrador</field><field name="model_id" ref="model_incmd_request_assignment"/><field name="groups" eval="[(4,ref('group_admin'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
</odoo>