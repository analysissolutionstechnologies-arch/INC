<odoo>
<record id="unit_list" model="ir.ui.view"><field name="name">unit_list</field><field name="model">incmd.request.unit</field><field name="arch" type="xml"><list><field name="name"/><field name="kind"/><field name="receives"/><field name="supervisor_ids" widget="many2many_tags"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="unit_form" model="ir.ui.view"><field name="name">unit_form</field><field name="model">incmd.request.unit</field><field name="arch" type="xml"><form><sheet><widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/><div class="oe_title"><h1><field name="name" placeholder="Área o tienda"/></h1></div><group><group><field name="kind"/><field name="receives"/><field name="department_id"/><field name="active"/></group><group><field name="company_id" groups="base.group_multi_company"/></group></group><notebook><page string="Equipo de atención"><field name="member_ids" widget="many2many_tags"/><p class="text-muted">Estos usuarios atienden las etapas asignadas al equipo destinatario.</p></page><page string="Supervisores"><field name="supervisor_ids" widget="many2many_tags"/><p class="text-muted">Con perfil Supervisor, podrán consultar las solicitudes enviadas desde esta unidad. Pueden supervisar varias unidades.</p></page></notebook></sheet></form></field></record>
<record id="assignment_list" model="ir.ui.view"><field name="name">assignment_list</field><field name="model">incmd.request.assignment</field><field name="arch" type="xml"><list><field name="user_id"/><field name="unit_id"/><field name="role"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="assignment_form" model="ir.ui.view"><field name="name">assignment_form</field><field name="model">incmd.request.assignment</field><field name="arch" type="xml"><form><sheet><group><field name="user_id" options="{'no_create':True}"/><field name="unit_id"/><field name="role"/><field name="company_id" groups="base.group_multi_company"/></group><div class="alert alert-info">El perfil se aplica al usuario en todo el módulo. Las unidades supervisadas se definen en Áreas y tiendas → Supervisores.</div></sheet></form></field></record>
<record id="reason_list" model="ir.ui.view"><field name="name">reason_list</field><field name="model">incmd.request.reason</field><field name="arch" type="xml"><list><field name="name"/><field name="unit_id"/><field name="process_id"/><field name="active"/></list></field></record>
<record id="reason_form" model="ir.ui.view"><field name="name">reason_form</field><field name="model">incmd.request.reason</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name" placeholder="Motivo"/></h1></div><group><field name="unit_id"/><field name="process_id" options="{'no_create':True}"/><field name="active"/><field name="description"/></group><div class="alert alert-info">El proceso publicado se asignará al enviar la solicitud. Puede compartir un proceso entre varios motivos.</div></sheet></form></field></record>
<record id="process_list" model="ir.ui.view"><field name="name">process_list</field><field name="model">incmd.request.process</field><field name="arch" type="xml"><list><field name="name"/><field name="unit_id"/><field name="version"/><field name="state" widget="badge" decoration-success="state == 'published'"/></list></field></record>
<record id="process_form" model="ir.ui.view"><field name="name">process_form</field><field name="model">incmd.request.process</field><field name="arch" type="xml"><form><header><button name="action_publish" type="object" string="Publicar versión" class="btn-primary" invisible="state != 'draft'"/><button name="action_new_version" type="object" string="Crear nueva versión" invisible="state != 'published'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="state != 'draft'"/></h1></div><group><field name="unit_id" readonly="state != 'draft'"/><field name="version" readonly="state != 'draft'"/></group><div class="alert alert-info" invisible="state != 'published'">Esta versión está protegida. Cree otra versión para cambiar el flujo sin afectar solicitudes existentes.</div><notebook><page string="1. Etapas"><field name="stage_ids" readonly="state != 'draft'" context="{'default_process_id':id}"><list><field name="sequence" widget="handle"/><field name="name"/><field name="is_initial"/><field name="actor_type"/><field name="requires_approval"/><field name="is_closed"/></list></field></page><page string="2. Acciones y rutas"><field name="transition_ids" readonly="state != 'draft'" context="{'default_process_id':id}"><list><field name="sequence" widget="handle"/><field name="name"/><field name="from_stage_id"/><field name="to_stage_id"/><field name="kind"/></list></field><p class="text-muted">Defina las salidas de cada etapa: avanzar, aprobar, devolver o rechazar. Cree una etapa de cierre para los rechazos.</p></page></notebook></sheet></form></field></record>
<record id="stage_form" model="ir.ui.view"><field name="name">stage_form</field><field name="model">incmd.request.stage</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="process_id" readonly="1"/><field name="sequence"/><field name="is_initial"/><field name="is_closed"/></group><group><field name="actor_type"/><field name="actor_ids" widget="many2many_tags" invisible="actor_type != 'users'" required="actor_type == 'users'"/><field name="requires_approval"/><field name="attachment_required"/></group></group><p class="text-muted">Todo seguimiento exige comentario para conservar trazabilidad. Los adjuntos obligatorios deben cargarse al ejecutar la acción.</p></sheet></form></field></record>
<record id="transition_form" model="ir.ui.view"><field name="name">transition_form</field><field name="model">incmd.request.transition</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="process_id" readonly="1"/><field name="sequence"/><field name="from_stage_id" options="{'no_create':True}"/><field name="to_stage_id" options="{'no_create':True}"/><field name="kind"/></group></sheet></form></field></record>
<record id="action_unit" model="ir.actions.act_window"><field name="name">Áreas y tiendas</field><field name="res_model">incmd.request.unit</field><field name="view_mode">list,form</field></record>
<record id="action_assignment" model="ir.actions.act_window"><field name="name">Usuarios y perfiles</field><field name="res_model">incmd.request.assignment</field><field name="view_mode">list,form</field></record>
<record id="action_reason" model="ir.actions.act_window"><field name="name">Motivos</field><field name="res_model">incmd.request.reason</field><field name="view_mode">list,form</field></record>
<record id="action_process" model="ir.actions.act_window"><field name="name">Procesos y versiones</field><field name="res_model">incmd.request.process</field><field name="view_mode">list,form</field></record>
</odoo>