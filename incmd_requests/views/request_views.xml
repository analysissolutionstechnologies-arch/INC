<odoo>
 <record id="request_list" model="ir.ui.view"><field name="name">incmd.request.list</field><field name="model">incmd.request</field><field name="arch" type="xml"><list decoration-muted="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'rejected'"><field name="number"/><field name="name"/><field name="requester_id"/><field name="origin_id"/><field name="unit_id"/><field name="reason_id"/><field name="process_id" optional="hide"/><field name="stage_id"/><field name="responsible_id"/><field name="state" widget="badge"/><field name="submitted_at" optional="show"/></list></field></record>
 <record id="request_form" model="ir.ui.view"><field name="name">incmd.request.form</field><field name="model">incmd.request</field><field name="arch" type="xml">
  <form class="incmd_request_form"><header><button name="action_submit" type="object" string="Enviar solicitud" class="btn-primary" invisible="state != 'draft' or not is_owner" confirm="Al enviar, los datos y adjuntos originales quedarán bloqueados. ¿Enviar solicitud?"/><button name="action_followup" type="object" string="Registrar avance / Ejecutar acción" class="btn-primary" invisible="state != 'open' or not can_handle"/><button name="action_followup" type="object" string="Responder / Aclarar" invisible="state != 'open' or not is_owner or can_handle"/><button name="action_process_board" type="object" string="Tablero del proceso" invisible="state == 'draft'"/><field name="stage_id" widget="statusbar" domain="[('process_id','=',process_id)]" options="{'clickable':False}" invisible="state == 'draft'"/></header>
  <sheet><field name="can_handle" invisible="1"/><field name="is_owner" invisible="1"/><field name="company_id" invisible="1"/><div class="oe_title"><h2><field name="number"/></h2><h1><field name="name" placeholder="Asunto de la solicitud" readonly="state != 'draft' or not is_owner"/></h1></div>
   <div class="alert alert-info" invisible="state == 'draft'"><i class="fa fa-lock me-2"/>Solicitud original protegida. Registre respuestas, evidencias y avances en el seguimiento.</div>
   <group><group string="Solicitud original"><field name="requester_id"/><field name="origin_id"/><field name="unit_id" readonly="state != 'draft' or not is_owner" options="{'no_create':True}"/><field name="reason_id" readonly="state != 'draft' or not is_owner" options="{'no_create':True}"/></group><group string="Atención"><field name="process_id"/><field name="stage_id"/><field name="responsible_id"/><field name="submitted_at"/><field name="closed_at" invisible="not closed_at"/></group></group>
   <notebook><page string="Descripción y documentos"><field name="description" placeholder="Describa lo que necesita..." readonly="state != 'draft' or not is_owner"/><separator string="Adjuntos originales"/><field name="original_attachment_ids" widget="many2many_binary" readonly="state != 'draft' or not is_owner"/></page><page string="Historial de atención"><field name="history_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="create_date" string="Fecha"/><field name="user_id"/><field name="action"/><field name="from_stage_id"/><field name="to_stage_id"/><field name="comment"/><field name="attachment_ids" widget="many2many_binary"/></list></field></page></notebook>
  </sheet><chatter/></form>
 </field></record>
 <record id="request_search" model="ir.ui.view"><field name="name">incmd.request.search</field><field name="model">incmd.request</field><field name="arch" type="xml"><search><field name="number"/><field name="name"/><field name="requester_id"/><field name="origin_id"/><field name="unit_id"/><field name="reason_id"/><field name="process_id"/><filter name="mine" string="Mis solicitudes" domain="[('requester_id','=',uid)]"/><filter name="open" string="En atención" domain="[('state','=','open')]"/><filter name="draft" string="Borradores" domain="[('state','=','draft')]"/><filter name="closed" string="Cerradas" domain="[('state','in',['done','rejected'])]"/><separator/><filter name="by_origin" string="Área o tienda de origen" context="{'group_by':'origin_id'}"/><filter name="by_area" string="Área destinataria" context="{'group_by':'unit_id'}"/><filter name="by_process" string="Proceso y versión" context="{'group_by':'process_id'}"/><filter name="by_stage" string="Etapa" context="{'group_by':'stage_id'}"/></search></field></record>
 <record id="request_kanban" model="ir.ui.view"><field name="name">incmd.request.kanban</field><field name="model">incmd.request</field><field name="arch" type="xml"><kanban default_group_by="stage_id" records_draggable="false" groups_draggable="false" group_create="false" group_delete="false" quick_create="false"><field name="state"/><templates><t t-name="card"><div class="incmd_request_card"><strong class="text-primary"><field name="number"/></strong><div class="fw-bold my-2"><field name="name"/></div><div class="text-muted"><i class="fa fa-building me-1"/><field name="origin_id"/></div><div class="small text-muted mt-1"><field name="reason_id"/></div><div class="mt-2 d-flex justify-content-between"><field name="responsible_id" widget="many2one_avatar_user"/><field name="state" widget="label_selection"/></div></div></t></templates></kanban></field></record>
 <record id="request_pivot" model="ir.ui.view"><field name="name">incmd.request.pivot</field><field name="model">incmd.request</field><field name="arch" type="xml"><pivot string="Solicitudes por área"><field name="origin_id" type="row"/><field name="unit_id" type="col"/><field name="state" type="row"/></pivot></field></record>
 <record id="action_my_requests" model="ir.actions.act_window"><field name="name">Mis solicitudes</field><field name="res_model">incmd.request</field><field name="view_mode">list,kanban,form</field><field name="domain">[('requester_id','=',uid)]</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cree su primera solicitud</p><p>Seleccione el área y el motivo. Su origen se completa automáticamente.</p></field></record>
 <record id="action_inbox" model="ir.actions.act_window"><field name="name">Bandeja de atención</field><field name="res_model">incmd.request</field><field name="view_mode">list,kanban,form</field><field name="domain">[('state','!=','draft')]</field><field name="context">{'search_default_open':1}</field></record>
 <record id="action_supervision" model="ir.actions.act_window"><field name="name">Solicitudes de mis áreas y tiendas</field><field name="res_model">incmd.request</field><field name="view_mode">list,kanban,form,pivot,graph</field><field name="domain">[('state','!=','draft'),('origin_id.supervisor_ids','in',[uid])]</field><field name="context">{'search_default_by_origin':1}</field></record>
 <record id="action_reports" model="ir.actions.act_window"><field name="name">Análisis de solicitudes</field><field name="res_model">incmd.request</field><field name="view_mode">pivot,graph,list,form</field><field name="domain">[('state','!=','draft')]</field></record>
</odoo>
