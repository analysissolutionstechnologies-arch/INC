<odoo><record id="action_wizard_form" model="ir.ui.view"><field name="name">incmd.request.action.form</field><field name="model">incmd.request.action</field><field name="arch" type="xml"><form string="Seguimiento de solicitud"><group><field name="request_id" options="{'no_open':True}"/><field name="stage_id"/><field name="can_handle" invisible="1"/><field name="transition_id" invisible="not can_handle" options="{'no_create':True}"/><field name="responsible_id" invisible="not can_handle" options="{'no_create':True}"/><field name="comment" placeholder="Detalle la gestión, respuesta o evidencia..."/><field name="attachment_ids" widget="many2many_binary"/></group><div class="alert alert-info">Deje la acción vacía para registrar un avance sin cambiar la etapa. La solicitud original no se modifica.</div><footer><button name="action_apply" type="object" string="Registrar" class="btn-primary"/><button string="Cancelar" special="cancel" class="btn-secondary"/></footer></form></field></record><record id="redirect_wizard_form" model="ir.ui.view"><field name="name">incmd.request.redirect.form</field><field name="model">incmd.request.redirect</field><field name="arch" type="xml"><form string="Redirigir a otra área"><group><field name="request_id"/><field name="company_id" invisible="1"/><field name="unit_id" options="{'no_create':True}"/><field name="reason_id" options="{'no_create':True}"/><field name="process_id"/><field name="responsible_id" options="{'no_create':True}"/><field name="comment"/></group><div class="alert alert-info">Conserva el número, la solicitud original y el historial. La atención comienza en la etapa inicial del nuevo proceso.</div><footer><button name="action_apply" type="object" string="Confirmar traslado" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record></odoo>