<?xml version="1.0" encoding="UTF-8"?>
<templates id="warehouse_management" inherit_id="point_of_sale.template" xml:space="preserve">
    <t t-name="point_of_sale.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('product-img')]" position="after">
            <t t-set="product_val" t-value="pos.db.product_by_id[props.productId]"/>
            <t t-if="pos.config.display_stock">
                <t t-if="product_val.type == 'product'">
                    <t t-if="pos.config.stock_qty == 'qty_available'">
                        <t t-if="product_val.qty_available > 0">
                            <span class="qty-label" id="stockqty">
                                <t t-esc="product_val.qty_available"/>
                            </span>
                        </t>
                        <t t-else="">
                            <span class="qty-label out-of-stock-qty" id="stockqty">
                                <t t-esc="product_val.qty_available"/>
                            </span>
                        </t>
                    </t>

                    <t t-if="pos.config.stock_qty == 'virtual_available'">
                        <t t-if="props.product.virtual_available > 0">
                            <span class="qty-label" id="availqty">
                                <t t-esc="product_val.virtual_available"/>
                            </span>
                        </t>
                        <t t-else="">
                            <span class="qty-label out-of-stock-qty" id="availqty">
                                <t t-esc="product_val.virtual_available"/>
                            </span>
                        </t>
                    </t>
                </t>
            </t>
        </xpath>
    </t>

    <t t-name="bi_pos_multi_warehouse.PosStockWarehouse" owl="1">
        <div class="popup popup-import">
            <div class="modal-header">
                <h4 class="modal-title title drag-handle">
                   Warehouses
                </h4>
            </div>
            <main class="body modal-body">
                <table class="table">
                    <thead>
                        <th name="Name_warehouse">Warehouse</th>
                        <th name="qty_available">Available</th>
                        <th name="qty">Qty</th>
                    </thead>
                    <tbody>
                        <tr t-foreach="props.rec || []" t-as="qty" t-key="qty['id']">
                            <!-- Verifica que solo se muestren las bodegas con inventario -->
                            <t t-if="qty['quantity'] > 0">
                                <td name="Name_warehouse">
                                    <t t-esc="qty['location']"/>
                                </td>
                                <td name="qty_available">
                                    <t t-esc="qty['quantity']"/>
                                </td>
                                <td class="entered_item_qty">
                                    <input id="entered_item_qty" 
                                        t-att-loc="qty['location']" 
                                        t-att-loc-id="qty['location']" 
                                        t-att-locdbid="qty['id']" 
                                        t-att-qty-id="qty['quantity']" 
                                        type="text" class="stock_id" 
                                        name="stock_qty"/>
                                </td>
                            </t>
                        </tr>
                    </tbody>
                </table>
            </main>
            <footer class="footer modal-footer">
                <div class="button btn btn-lg btn-primary" t-on-click="apply">
                    <t t-esc="props.confirmText"/>
                </div>
                <div class="button cancel btn btn-lg btn-primary" t-on-click="cancel">
                    <t t-esc="props.cancelText"/>
                </div>
            </footer>
        </div>
    </t>

    <t t-extend="Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension" owl="1">
        <xpath expr="//ul[hasclass('info-list')]" position="inside">
            <ul class="info-list">
                <li class="info orderline-stock_location_name">
                    <b>Location</b>: <t t-esc="line.location_name"/>
                </li>
            </ul>
        </xpath>
    </t>
</templates>


