<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incmd_activo_traslado_wizard_form" model="ir.ui.view">
        <field name="name">incmd.activo.traslado.wizard.form</field>
        <field name="model">incmd.activo.traslado.wizard</field>
        <field name="arch" type="xml">
            <form string="Trasladar Activo">
                <group>
                    <field name="activo_id" readonly="1"/>
                    <field name="origin_location_id" readonly="1"/>
                    <field name="destination_location_id" options="{'no_create': True}"/>
                    <field name="department_id"/>
                    <field name="responsible_employee_id"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar Traslado" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
