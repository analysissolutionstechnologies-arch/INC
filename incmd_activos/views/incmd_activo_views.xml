<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incmd_activo_tree" model="ir.ui.view">
        <field name="name">incmd.activo.tree</field>
        <field name="model">incmd.activo</field>
        <field name="arch" type="xml">
            <tree string="Activos Fijos">
                <field name="code"/>
                <field name="name"/>
                <field name="location_id"/>
                <field name="department_id"/>
                <field name="responsible_employee_id"/>
                <field name="generic"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_incmd_activo_search" model="ir.ui.view">
        <field name="name">incmd.activo.search</field>
        <field name="model">incmd.activo</field>
        <field name="arch" type="xml">
            <search string="Buscar Activos">
                <field name="code"/>
                <field name="name"/>
                <field name="location_id"/>
                <field name="department_id"/>
                <field name="responsible_employee_id"/>
                <filter name="draft" string="Borrador" domain="[('state','=','draft')]"/>
                <filter name="assigned" string="Asignado" domain="[('state','=','assigned')]"/>
                <filter name="archived" string="Baja" domain="[('state','=','archived')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_location" string="Ubicación" context="{'group_by':'location_id'}"/>
                    <filter name="group_department" string="Departamento" context="{'group_by':'department_id'}"/>
                    <filter name="group_responsible" string="Responsable" context="{'group_by':'responsible_employee_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_incmd_activo_form" model="ir.ui.view">
        <field name="name">incmd.activo.form</field>
        <field name="model">incmd.activo</field>
        <field name="arch" type="xml">
            <form string="Activo Fijo">
                <header>
                    <button name="action_open_activate_wizard" type="object" string="Activar / Alta" class="btn-primary" invisible="state != 'draft'" groups="incmd_activos.group_incmd_activos_manager"/>
                    <button name="action_open_traslado_wizard" type="object" string="Trasladar" class="btn-secondary" invisible="state not in ('assigned','transit')" groups="incmd_activos.group_incmd_activos_manager"/>
                    <button name="action_open_archive_wizard" type="object" string="Dar de Baja" class="btn-danger" invisible="state == 'archived'" groups="incmd_activos.group_incmd_activos_manager"/>
                    <button name="action_print_responsabilidad" type="object" string="Documento Responsabilidad" invisible="state == 'draft'" groups="incmd_activos.group_incmd_activos_manager"/>
                    <button name="action_print_history" type="object" string="Línea de Vida" invisible="state == 'draft'" groups="incmd_activos.group_incmd_activos_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,transit,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Datos de Identificación">
                            <field name="code" readonly="1"/>
                            <field name="product_id"
                                options="{'no_create': True, 'no_open': True}"
                                domain="[('detailed_type', '=', 'product')]"
                                context="{'search_by_barcode': True}"
                                readonly="id != False"/>
                            <field name="barcode" readonly="1"/>
                            <field name="generic" readonly="id != False"/>
                            <field name="brand" readonly="id != False"/>
                            <field name="model" readonly="id != False"/>
                            <field name="serie"/>
                        </group>
                        <group string="Responsables y Ubicación">
                            <field name="responsible_employee_id" readonly="id != False"/>
                            <field name="location_id" options="{'no_create': True, 'no_open': True}" readonly="id != False"/>
                            <field name="requires_department" invisible="1"/>
                            <field name="department_id" required="requires_department" readonly="id != False"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Información de Compra" groups="incmd_activos.group_incmd_activos_manager">
                            <group>
                                <group>
                                    <field name="nit_proveedor" readonly="id != False"/>
                                    <field name="supplier_partner_id" readonly="1"
                                        options="{'no_open': True}"/>
                                </group>
                            </group>
                            <group>
                                <field name="purchase_invoice_id"
                                    options="{'no_create': True, 'no_open': True}"
                                    readonly="supplier_partner_id == False or id != False"/>
                                <field name="purchase_date" readonly="id != False"/>
                                <field name="currency_id" groups="base.group_multi_currency" readonly="id != False"/>
                                <field name="original_value" readonly="id != False"/>
                                <field name="depreciation_rate" widget="percentage" readonly="id != False"/>
                            </group>
                        </page>
                        <page string="Historial de Línea de Vida">
                            <field name="history_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="date"/>
                                    <field name="origin_location_id"/>
                                    <field name="destination_location_id"/>
                                    <field name="department_id"/>
                                    <field name="responsible_employee_id"/>
                                    <field name="event_type"/>
                                    <field name="executed_by_id"/>
                                    <field name="observation"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_incmd_activo" model="ir.actions.act_window">
        <field name="name">Activos Fijos</field>
        <field name="res_model">incmd.activo</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="action_incmd_activo_export_xlsx" model="ir.actions.act_url">
        <field name="name">Exportar Activos XLSX</field>
        <field name="url">/incmd_activos/export_xlsx</field>
        <field name="target">self</field>
    </record>
</odoo>
