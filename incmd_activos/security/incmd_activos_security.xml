<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_incmd_activos" model="ir.module.category">
        <field name="name">Activos Fijos Incomel</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_incmd_activos_user" model="res.groups">
        <field name="name">Usuario de Activos</field>
        <field name="category_id" ref="module_category_incmd_activos"/>
    </record>

    <record id="group_incmd_activos_manager" model="res.groups">
        <field name="name">Administrador de Activos</field>
        <field name="category_id" ref="module_category_incmd_activos"/>
        <field name="implied_ids" eval="[(4, ref('group_incmd_activos_user'))]"/>
    </record>
</odoo>
