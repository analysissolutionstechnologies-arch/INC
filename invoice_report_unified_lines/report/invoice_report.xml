<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_unified_lines" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-foreach='lines' and @t-as='line']" position="replace">
            <t t-if="not lines.filtered(lambda l: l.product_id.x_studio_es_moto_1)">
                <t t-foreach="lines" t-as="line">
                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                    <t t-set="current_total" t-value="current_total + line.price_total"/>

                    <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                        <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                            <td name="account_invoice_line_name"><span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Bacon Burger</span></td>
                            <td name="td_quantity" class="text-end">
                                <span t-field="line.quantity">3.00</span>
                                <span t-field="line.product_uom_id" groups="uom.group_uom">units</span>
                            </td>
                            <td name="td_price_unit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span class="text-nowrap" t-field="line.price_unit">9.00</span>
                            </td>
                            <td name="td_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span class="text-nowrap" t-field="line.discount">0</span>
                            </td>
                            <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                            <td name="td_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                <span t-out="taxes" id="line_tax_ids">Tax 15%</span>
                            </td>
                            <td name="td_subtotal" class="text-end o_price_total">
                                <span class="text-nowrap" t-field="line.price_subtotal">27.00</span>
                            </td>
                        </t>
                        <t t-elif="line.display_type == 'line_section'">
                            <td colspan="99">
                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">A section title</span>
                            </td>
                            <t t-set="current_section" t-value="line"/>
                            <t t-set="current_subtotal" t-value="0"/>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <td colspan="99">
                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">A note, whose content usually applies to the section or product above.</span>
                            </td>
                        </t>
                    </tr>

                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                        <tr class="is-subtotal text-end">
                            <td colspan="99">
                                <strong class="mr16">Subtotal</strong>
                                <span t-out="current_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>31.05</span>
                            </td>
                        </tr>
                    </t>
                </t>
            </t>
            <t t-else="">
                <t t-set="lines_custom" t-value="o.get_lines_for_report()"/>
                <t t-foreach="lines_custom" t-as="line">
                    <t t-set="taxes_custom" t-value="', '.join([imp.get('nombre_corto') for imp in line.get('impuestos', []) if imp.get('nombre_corto')])"/>
                    <tr>
                        <td name="account_invoice_line_name">
                            <span t-out="line['name']">Product</span>
                        </td>
                        <td name="td_quantity" class="text-end">
                            <span t-out="line['quantity']">1.00</span>
                        </td>
                        <td name="td_price_unit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span class="text-nowrap" t-out="line['price_unit']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>0.00</span>
                        </td>
                        <td name="td_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span class="text-nowrap">0</span>
                        </td>
                        <td name="td_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes_custom) &lt; 10 else '' }}">
                            <span t-out="taxes_custom">Taxes</span>
                        </td>
                        <td name="td_subtotal" class="text-end o_price_total">
                            <span class="text-nowrap" t-out="line.get('price', line.get('total', 0.0))" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>0.00</span>
                        </td>
                    </tr>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
