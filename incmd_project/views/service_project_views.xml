<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_task_form_inherit_excepcion" model="ir.ui.view">
      <field name="name">project.task.form.inherit.excepcion</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="studio_customization.odoo_studio_project__8717e731-cc92-48b5-8a0c-38d49fc675d4"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='x_studio_sub_excepcion']" position="attributes">
          <attribute name="domain">[('x_studio_excepcion_padre','=', x_studio_motivo_excepcion), ('x_studio_proyecto','in',[project_id])]</attribute>
        </xpath>
        <xpath expr="//field[@name='x_studio_sub_rechazo']" position="attributes">
          <attribute name="domain">[('x_studio_rechazo_padre','=', x_studio_motivo_rechazo), ('x_studio_proyecto','in',[project_id])]</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>