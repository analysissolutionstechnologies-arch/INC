<templates xml:space="preserve">
 <t t-name="incmd_b2_storage.DocumentPreview">
  <div class="o_b2_document_preview">
   <t t-if="!props.record.resId" t-call="web.BinaryField"/>
   <div t-if="documentName" class="border rounded p-3 mt-3">
    <div class="mb-2 text-break"><i class="fa fa-file-o me-2"/><t t-esc="documentName"/></div>
    <a t-if="previewSource &amp;&amp; previewKind === 'image'" t-att-href="fullImageSource" target="_blank" rel="noopener"><img t-att-src="previewSource" alt="Vista previa del documento" style="max-width:100%;max-height:320px;object-fit:contain"/></a>
    <iframe t-if="previewSource &amp;&amp; previewKind === 'pdf'" t-att-src="previewSource" title="Vista previa del PDF" style="width:100%;height:360px;border:0"/>
    <div t-if="previewKind === 'document'" class="text-muted">Documento seleccionado. La vista previa de este formato requiere abrir el archivo.</div>
   </div>
  </div>
 </t>
</templates>
