    </div>
    <div class="text-center small text-break mt-2"><t t-esc="current.name"/></div>
    <div class="text-center text-muted small"><t t-esc="state.index + 1"/> / <t t-esc="state.documents.length"/></div>
   </t>
   <div t-else="" class="text-center text-muted p-3">No hay documentos cargados.</div>
  </div>
 </t>
</templates>
