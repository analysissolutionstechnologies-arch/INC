      <img t-if="isImage" t-att-src="source" alt="Documento de la tarea" style="max-width:100%;height:600px;max-height:70vh;object-fit:contain"/>
      <div t-else="" class="text-muted"><i class="fa fa-file-o" style="font-size:64px"/><div class="small mt-2">Abrir documento</div></div>
