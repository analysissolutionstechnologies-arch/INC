    <t t-inherit="stock_barcode.MainMenu" t-inherit-mode="extension">
        <!-- Remove Inventory Adjustments button -->
        <xpath expr="//div[hasclass('o_main_menu_buttons')]//button[hasclass('button_inventory')]/.." position="replace">
        </xpath>

        <!-- Remove Batch Transfer button -->
        <xpath expr="//button[hasclass('button_batch_transfer')]" position="replace">
