<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_payment_form_inh" model="ir.ui.view">
            <field name="name">pos.payment.form.inh</field>
            <field name="model">pos.payment</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='session_id']" position="after">
                     <field name="payment_reference"/>
                     <field name="bank_id"/>
                     <field name="number_quote"/>
                     <field name="card_termination" invisible="1"/>
                     <field name="auth_number"/>
                     <field name="comment" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>