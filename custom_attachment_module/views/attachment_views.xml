<odoo>

    <record id="view_attachment_form_inherit" model="ir.ui.view">
        <field name="name">ir.attachment.form.inherit</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_download_file" string="Preview" type="object" class="oe_highlight" invisible="not external_url"/>
                </header>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="external_url" invisible="1"/>
            </xpath>
            <xpath expr="//sheet/group" position="inside">
                <group string="Backblaze Information" name="backblaze_info" groups="custom_attachment_module.group_custom_attachment_admin">
                    <field name="hash_value" readonly="1"/>
                    <field name="external_url" widget="url" readonly="1"/>
                    <field name="use_backblaze"/>
                    <field name="upload_error" readonly="1" invisible="not upload_error"/> 
                </group>
            </xpath>
            <xpath expr="//sheet/group/group[3]" position="before">
                <group string="External URL Preview" name="external_url_preview" invisible="not external_url" colspan="2">
                    <field name="view_extrenal_url_text" widget="iframe_url"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_attachment_tree_inherit" model="ir.ui.view">
        <field name="name">ir.attachment.tree.inherit</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_tree"/>
        <field name="arch" type="xml">
            <tree position="inside">
                <field name="hash_value" optional="show"/>
                <field name="external_url" optional="show"/>
                <field name="use_backblaze" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_attachment_search_inherit" model="ir.ui.view">
        <field name="name">ir.attachment.search.inherit</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='url_filter']" position="after">
                <filter string="Backblaze Stored" name="backblaze_stored" domain="[('external_url', '!=', False)]"/>
                <filter string="Local Stored" name="local_stored" domain="[('external_url', '=', False)]"/>
            </xpath>
        </field>
    </record>
<!--  Action for Backblaze Attachments  -->
    <record id="action_backblaze_attachment_list" model="ir.actions.act_window">
        <field name="name">Backblaze Attachments</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_use_backblaze': True}</field>
        <field name="domain">[('use_backblaze', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> No Backblaze attachments found </p>
            <p> Create a new attachment and enable Backblaze storage to see it here. </p>
        </field>
    </record>
<!--  Menu item for Backblaze Attachments  -->
    <menuitem id="menu_backblaze_attachment" 
    name="Backblaze Attachments" 
    action="action_backblaze_attachment_list" 
    parent="base.menu_management" 
    groups="custom_attachment_module.group_custom_attachment_admin"
    sequence="10"/>

</odoo>
