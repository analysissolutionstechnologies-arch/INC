<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_custom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.custom.attachment</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Custom Attachment" string="Custom Attachment" name="custom_attachment_module" groups="base.group_user">
                    <block title="Configuración de Adjuntos" name="attachment_config">
                        <setting help="Extensiones permitidas para adjuntos (ej: .png, .jpg, .pdf)" id="allowed_attachment_extensions">
                            <field name="allowed_attachment_extensions"/>
                        </setting>
                        <setting help="Seleccione los modelos en los que se aplicará esta configuración de extensiones. Si no se selecciona ninguno, se aplicará a todos los modelos." id="restricted_attachment_models">
                            <field name="restricted_attachment_models" widget="many2many_tags"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
