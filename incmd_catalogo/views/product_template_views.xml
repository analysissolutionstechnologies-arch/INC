<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_incmd_catalogo" model="ir.ui.view">
        <field name="name">product.template.form.inherit.incmd.catalogo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Catálogos Públicos" groups="base.group_system">
                    <group>
                        <group string="Visibilidad por página">
                            <field name="x_mostrar_en_incomel"/>
                            <field name="x_mostrar_en_tecnialiado"/>
                            <field name="x_mostrar_en_catalogo" invisible="1"/>
                        </group>
                        <group string="Estado visual">
                            <field name="x_disponible"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Un producto puede mostrarse solo en Incomel, solo en Tecnialiado o en ambos catálogos.
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
