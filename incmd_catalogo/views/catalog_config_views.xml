<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incmd_catalog_config_tree" model="ir.ui.view">
        <field name="name">incmd.catalog.config.tree</field>
        <field name="model">incmd.catalog.config</field>
        <field name="arch" type="xml">
            <tree string="Catálogos Públicos" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key"/>
                <field name="page_size"/>
                <field name="location_ids" widget="many2many_tags"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_incmd_catalog_config_form" model="ir.ui.view">
        <field name="name">incmd.catalog.config.form</field>
        <field name="model">incmd.catalog.config</field>
        <field name="arch" type="xml">
            <form string="Catálogo Público" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="key" readonly="1"/>
                            <field name="page_size"/>
                            <field name="active"/>
                        </group>
                        <group string="Existencias">
                            <field name="location_ids" widget="many2many_tags" domain="[('usage','=','internal')]" options="{'no_create': True}"/>
                        </group>
                        <group string="Precios del catálogo">
                            <field name="special_offer_pricelist_id" options="{'no_create': True}"/>
                            <field name="special_offer_fallback_field_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="credit_pricelist_id" options="{'no_create': True}"/>
                            <field name="credit_fallback_field_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Seleccione únicamente ubicaciones internas de existencias. El catálogo mostrará stock solo de las ubicaciones configuradas aquí.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_incmd_catalog_config" model="ir.actions.act_window">
        <field name="name">Catálogos Públicos</field>
        <field name="res_model">incmd.catalog.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_incmd_catalog_config"
              name="Catálogos Públicos"
              parent="website.menu_website_configuration"
              action="action_incmd_catalog_config"
              sequence="85"
              groups="base.group_system"/>
</odoo>
