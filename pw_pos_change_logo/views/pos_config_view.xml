<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_pw_pos_change_logo" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.pos.change.logo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting help="Set logo on pos screen and receipt">
                    <field name="pw_change_logo"/>
                    <div class="content-group mt16" invisible="not pw_change_logo">
                        <field name="pw_pos_logo" widget="image" class="oe_avatar" style="float: left;"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
