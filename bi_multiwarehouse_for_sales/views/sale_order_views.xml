<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sale Order Form view -->
    <record id='sale_order_view_form' model='ir.ui.view'>
        <field name='name'>inherit.sale.order.form.view</field>
        <field name='model'>sale.order</field>
        <field name='inherit_id' ref='sale.view_order_form'/>
        <field name='arch' type='xml'>

        <!-- Después del campo partner_id -->
        <xpath expr="//field[@name='partner_id']" position="after">
            <field name="is_multiwarehouse" invisible="1"/>
        </xpath>

        <!-- Modificación en las líneas de pedido -->
        <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='name']" position="before">
            <!-- Campo de almacén -->
            <field name="is_warehouse" column_invisible="1"/>
            <field name="warehouses_id" invisible ='is_warehouse == False' required ='is_warehouse == True and display_type == False'/>

            <!-- Nuevo campo para cantidad disponible -->
            <field name="product_available_qty" readonly="1" string="Available Quantity" />
        </xpath>

        </field>
    </record>
</odoo>



